<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cv="clr-namespace:Camera.MAUI;assembly=Camera.MAUI"
             x:Class="ValidatorMobileApp.MainPage">

    <Grid Margin="20,35,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Label Grid.Row="0" x:Name="barcodeResult" Text="qqq" />
        <cv:CameraView Grid.Row="1"
                       VerticalOptions="Fill"
                       HorizontalOptions="Fill"
                       x:Name="cameraView"  
                       CamerasLoaded="cameraView_CamerasLoaded" 
                       BarCodeDetectionEnabled="True"
                       BarCodeDetectionFrameRate="10"
                       BarcodeDetected="cameraView_BarcodeDetected"
                       />
        <Button Grid.Row="2" x:Name="buttonToClick" Clicked="buttonToClick_Clicked"/>
    </Grid>
</ContentPage>
